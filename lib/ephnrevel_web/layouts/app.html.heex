<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href={~p"/"}>EphnRevel</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><.link class="nav-link" navigate={~p"/dashboard"}>Dashboard</.link></li>
        <li class="nav-item"><.link class="nav-link" navigate={~p"/board"}>Board</.link></li>
        <li class="nav-item"><.link class="nav-link" navigate={~p"/nodes"}>Nodes</.link></li>
      </ul>
      <ul class="navbar-nav">
        <%= if @current_user do %>
          <li class="nav-item"><span class="nav-link"><%= @current_user.email %></span></li>
          <li class="nav-item">
            <.link href={~p"/users/log_out"} method="delete" class="nav-link">Log out</.link>
          </li>
        <% else %>
          <li class="nav-item"><.link class="nav-link" navigate={~p"/users/log_in"}>Log in</.link></li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
<main class="page-wrapper">
  <div class="page-body">
    <div class="container-xl py-4">
      <.flash_group flash={@flash} />
      {@inner_content}
    </div>
  </div>
</main>
